PORT=8004

# Downstream services. Inside Docker Compose use the service names
# (grocery-sso-service, db-backend, grocery-categorizer, grocery-telegram-adapter).
SSO_URL=http://localhost:8002
BACKEND_URL=http://localhost:8080
CATEGORIZER_URL=http://localhost:8003
TELEGRAM_ADAPTER_URL=http://localhost:8005

# Milliseconds before a call to a downstream service is abandoned
REQUEST_TIMEOUT_MS=5000
